# Configure this URL for your local PostgreSQL instance.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/siam_db?schema=public"
SEED_DEMO_PASSWORD="REPLACE_LOCALLY_WITH_AT_LEAST_12_CHARACTERS"

# Supabase project settings. The anon key is public; keep the service role key secret.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"
SUPABASE_STORAGE_BUCKET="ticket-attachments"